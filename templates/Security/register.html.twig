{% extends 'base.html.twig' %}

{% block title %}Registrieren{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-center justify-center bg-gray-100">
        <div class="w-full max-w-md bg-white p-8 rounded shadow">
            <h1 class="text-2xl font-bold mb-6 text-center">Registrieren</h1>
            {% for flash_error in app.flashes('error') %}
                <div class="mb-4 p-3 bg-red-100 text-red-700 rounded">
                    {{ flash_error }}
                </div>
            {% endfor %}

            {{ form_start(registrationForm, {'attr': {'class': 'space-y-4'}}) }}
            <div>
                {{ form_label(registrationForm.username, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(registrationForm.username, {'attr': {'class': 'mt-1 block w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring focus:border-blue-300'}}) }}
                {{ form_errors(registrationForm.username) }}
            </div>
            <div>
                {{ form_label(registrationForm.password, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(registrationForm.password, {'attr': {'class': 'mt-1 block w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring focus:border-blue-300'}}) }}
                {{ form_errors(registrationForm.password) }}
            </div>
            <div>
                {{ form_label(registrationForm.retype_password, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(registrationForm.retype_password, {'attr': {'class': 'mt-1 block w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring focus:border-blue-300'}}) }}
                {{ form_errors(registrationForm.retype_password) }}
            </div>
            <div>
                {{ form_label(registrationForm.agreeTerms, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'mt-1 block w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring focus:border-blue-300'}}) }}
                {{ form_errors(registrationForm.agreeTerms) }}
            </div>
            <button class="w-full py-2 px-4 bg-blue-600 text-white rounded hover:bg-blue-700 font-semibold" type="submit">
                Registrieren
            </button>
            {{ form_end(registrationForm) }}

            <div class="mt-4 text-center">
                <a href="{{ path('app_login') }}" class="text-blue-600 hover:underline">Bereits registriert? Zum Login</a>
            </div>
        </div>
    </div>
{% endblock %}
