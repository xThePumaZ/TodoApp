{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('app') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('app') }}
{% endblock %}

{% block navbar %}
{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-center justify-center bg-gray-100 dark:bg-gray-600">
        <div class="w-full max-w-md bg-white dark:bg-gray-500 p-8 rounded shadow">
            <h1 class="text-2xl font-bold mb-6 text-center dark:text-gray-100">Login</h1>
            {% if error %}
                <div class="mb-4 p-3 bg-red-100 text-red-500 rounded">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% if app.user %}
                <div class="mb-4 p-3 bg-green-100 text-green-700 rounded">
                    Du bist eingeloggt als {{ app.user.userIdentifier }},
                    <a href="{{ path('app_logout') }}" class="underline text-blue-600">Logout</a>
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" class="space-y-4">
                <div>
                    <label for="username" class="block text-sm font-medium text-gray-700 dark:text-gray-100">Benutzername</label>
                    <input type="text" value="{{ last_username }}" name="_username" id="username"
                           class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring focus:border-blue-300 dark:border-cyan-300 dark:focus:border-cyan-500 dark:text-gray-100"
                           autocomplete="username" required autofocus>
                </div>
                <div>
                    <label for="password" class="block text-sm font-medium text-gray-700 dark:text-gray-100">Passwort</label>
                    <input type="password" name="_password" id="password"
                           class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring focus:border-blue-300 dark:text-gray-100 dark:border-cyan-300 dark:focus:border-cyan-500"
                           autocomplete="current-password" required>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="w-full py-2 px-4 bg-blue-600 text-white rounded hover:bg-blue-700 font-semibold" type="submit">
                    Login
                </button>
            </form>
            <div class="mt-4 text-center">
                <a href="{{ path('app_register') }}" class="text-blue-600 hover:underline dark:text-blue-400">Noch kein Konto? Registrieren</a>
            </div>
        </div>
    </div>
{% endblock %}
