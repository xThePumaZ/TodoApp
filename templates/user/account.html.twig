{% extends 'base.html.twig' %}

{% block title %}Account Settings{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('app') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('app') }}
{% endblock %}

{% block body %}
    <div class="min-h-4/5 bg-gray-100 dark:bg-gray-700">
        <div class="max-w-screen-xl mx-auto py-8">
